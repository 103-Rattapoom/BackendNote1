  const offset=(page-1)*limit;
  const [rows]=await db.query('SELECT * FROM offices ORDER BY officeCode LIMIT ? OFFSET ?',[limit,offset]);
  const [[count]]=await db.query('SELECT COUNT(*) AS total FROM offices');
  return {rows,total:Number(count.total)};
}
export async function findOne(officeCode) {
