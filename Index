  constructor(message, statusCode=400, errorCode='BAD_REQUEST') {
    super(message);
    this.statusCode=statusCode;
    this.errorCode=errorCode;
  }
}
export function requiredString(value,field) {
  if (typeof value !== 'string' || !value.trim()) {
    throw new AppError(`${field} is required`,400,'VALIDATION_ERROR');
  }
  return value.trim();
}
export function positiveId(value) {
  if(typeof value !== 'string' || !/^[1-9]\d*$/.test(value) || !Number.isSafeInteger(Number(value))) {
    throw new AppError('Invalid numeric id',400,'VALIDATION_ERROR');
  }
  return Number(value);
}
export function parsePage(value, fallback) {
  if (value === undefined) return fallback;
  if(typeof value !== 'string' || !/^[1-9]\d*$/.test(value) || !Number.isSafeInteger(Number(value))) {
    throw new AppError('Invalid page or limit',400,'VALIDATION_ERROR');
  }
  return Number(value);
}
export function allowedFields(body, fields, {required=[],allowEmpty=false}={}) {
  if(!body || typeof body !== 'object' || Array.isArray(body)) throw new AppError('Expected JSON object',400,'VALIDATION_ERROR');
  const keys=Object.keys(body);
  if(!allowEmpty &amp;&amp; keys.length===0) throw new AppError('Body cannot be empty',400,'VALIDATION_ERROR');
  if(keys.some(k=&gt;!fields.includes(k))) throw new AppError('Unknown / protected field',400,'VALIDATION_ERROR');
  for(const k of required) if(body[k]===undefined || body[k]===null || body[k]==='') throw new AppError(`${k} required`,400,'VALIDATION_ERROR');
  return Object.fromEntries(keys.map(k=&gt;[k,body[k]]));
}
export const wrap = handler =&gt; (req,res,next)=&gt;Promise.resolve().then(()=&gt;handler(req,res,next)).catch(next);
export const ok = (res,data,code=200,pagination=null)=&gt;res.status(code).json({success:true,data,...(pagination?{pagination}:{})});
export function errorHandler(err,req,res,next) {
  const codes={ER_DUP_ENTRY:[409,'DUPLICATE_KEY'],ER_NO_REFERENCED_ROW_2:[400,'FOREIGN_KEY_NOT_FOUND'],ER_ROW_IS_REFERENCED_2:[409,'RESOURCE_IN_USE']};
  const sql=codes[err.code];
  const status=sql?.[0]??(Number.isInteger(err.statusCode)?err.statusCode:(err.status||500));
  const code=sql?.[1]??err.errorCode??'INTERNAL_SERVER_ERROR';
  const message=sql?(status===409?'Resource already exists or is referenced':'Referenced record does not exist'):
    (status===500?'Internal server error':err.message);
  console.error(`[${status}]`,err.code||'',err.message);
  return res.status(status).json({success:false,error:{code,message}});
}
