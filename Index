const BASE = `SELECT p.*, b.name AS brand_name FROM products p
              JOIN brands b ON b.id = p.brand_id`;

export async function findAll(limit, offset) {
  const [rows] = await db.query(`${BASE} ORDER BY p.id LIMIT ? OFFSET ?`, [limit, offset]);
  const [[count]] = await db.query('SELECT COUNT(*) AS total FROM products');
  return {rows, totalItems: count.total};
}
export async function findOne(id) {
  const [rows] = await db.query(`${BASE} WHERE p.id = ?`, [id]);
  return rows[0] ?? null;
}
export async function findBySku(sku) {
  const [rows] = await db.query('SELECT id FROM products WHERE sku = ?', [sku]);
  return rows[0] ?? null;
}
const COLUMNS = [
  'sku','name','brand_id','category','price','ram_gb',
  'storage_gb','color','stock_quantity','status','release_date'
];
export async function create(data) {
  const cols = COLUMNS.filter(c =&gt; data[c] !== undefined);
  const placeholders = cols.map(() =&gt; '?').join(', ');
  const [result] = await db.query(
    `INSERT INTO products (${cols.join(', ')}) VALUES (${placeholders})`,
    cols.map(c =&gt; data[c])
  );
  return findOne(result.insertId);
}
export async function update(id, data) {
  const cols = COLUMNS.filter(c =&gt; Object.hasOwn(data, c));
  const sets = cols.map(c =&gt; `${c} = ?`).join(', ');
  await db.query(`UPDATE products SET ${sets} WHERE id = ?`, [...cols.map(c =&gt; data[c]), id]);
  return findOne(id);
}
export async function remove(id) {
  const [result] = await db.query('DELETE FROM products WHERE id = ?', [id]);
  return result.affectedRows;
}
