  return rows[0]??null;
}
export async function create(body) {
  const cols=WRITABLE.filter(k=&gt;Object.hasOwn(body,k));
  const sql=`INSERT INTO offices (${cols.join(',')}) VALUES (${cols.map(()=&gt;'?').join(',')})`;
  await db.execute(sql,cols.map(k=&gt;body[k]));
  // officeCode เป็น String PK ไม่ใช้ result.insertId
  return findOne(body.officeCode);
}
export async function update(officeCode,body) {
  const cols=WRITABLE.filter(k=&gt;k!=='officeCode'&amp;&amp;Object.hasOwn(body,k));
  if(!cols.length) return findOne(officeCode);
  const sql=`UPDATE offices SET ${cols.map(c=&gt;`${c} = ?`).join(',')} WHERE officeCode = ?`;
  await db.execute(sql,[...cols.map(k=&gt;body[k]),officeCode]);
  return findOne(officeCode);
}
export async function remove(officeCode) {
