<td>Column ไม่มี</td>
<td><code>DESCRIBE</code> Table จริงก่อน</td>
<td>ชื่อ Source Sample อาจต่าง</td>
</tr>
</tbody>
</table>
<h3>ตัวอย่าง Filter + Sorting + Pagination ที่เชื่อมกัน</h3>
<pre><code class="language-js">const allowedSort = {price:'price', name:'name', id:'id'};
const sort = allowedSort[req.query.sortBy] || 'id';
const direction = req.query.order === 'desc' ? 'DESC' : 'ASC';
const status = req.query.status || null;
const where = status ? ' WHERE status = ?' : '';
const params = status ? [status] : [];
const [rows] = await db.query(
  `SELECT * FROM products${where} ORDER BY ${sort} ${direction} LIMIT ? OFFSET ?`,
  [...params, limit, offset]
);
const [[count]] = await db.query(
  `SELECT COUNT(*) AS total FROM products${where}`, params
);
</code></pre>
<p>นี่เป็น <strong>Extension จากความรู้ทั่วไปของ SQL</strong> สำหรับโจทย์เผื่อเพิ่ม Filter/Sort ไม่ได้ยืนยันว่ามีในข้อสอบปฏิบัติจริง</p>
