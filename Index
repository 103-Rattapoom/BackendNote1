import * as brandRepo from '../repositories/brand-repository.js';
import {httpError,positiveId,positivePage} from './errors.js';
import {summaryDTO,detailDTO} from '../mappers/product-dto.js';

const REQUIRED = ['sku','name','brand_id','category','price','ram_gb','storage_gb','color','stock_quantity','status','release_date'];
const WRITE_FIELDS = new Set(REQUIRED);
function cleaned(body, full) {
  if (!body || typeof body !== 'object' || Array.isArray(body)) throw httpError(400, 'JSON body must be an object');
  if (Object.keys(body).some(k =&gt; !WRITE_FIELDS.has(k))) throw httpError(400, 'Unknown or read-only field');
  if (full &amp;&amp; REQUIRED.some(k =&gt; body[k] === undefined || body[k] === null || body[k] === '')) throw httpError(400, 'Missing required fields');
  if (!full &amp;&amp; Object.keys(body).length === 0) throw httpError(400, 'No fields to update');
  if (body.price !== undefined &amp;&amp; (!Number.isFinite(Number(body.price)) || Number(body.price) &lt; 0)) throw httpError(400, 'Invalid price');
  if (body.stock_quantity !== undefined &amp;&amp; (!Number.isSafeInteger(Number(body.stock_quantity)) || Number(body.stock_quantity) &lt; 0)) throw httpError(400, 'Invalid stock_quantity');
  return body;
}
async function ensureBrand(brandId) {
  if (brandId !== undefined &amp;&amp; !await brandRepo.findOne(positiveId(String(brandId)))) throw httpError(400, 'brand_id does not exist');
}
export async function getAll(query) {
  const page = positivePage(query.page, 1);
  const limit = Math.min(positivePage(query.limit, 10), 100);
  const offset = (page - 1) * limit;
  const {rows, totalItems} = await repo.findAll(limit, offset);
  return {
    data: rows.map(summaryDTO),
    pagination: {total: totalItems, page, limit, totalPages: Math.ceil(totalItems / limit),
      hasNextPage: page * limit &lt; totalItems, hasPrevPage: page &gt; 1}
  };
}
export async function getById(rawId) {
  const row = await repo.findOne(positiveId(rawId));
  if (!row) throw httpError(404, 'Product not found');
  return detailDTO(row);
}
export async function create(body) {
  const data = cleaned(body, true);
  await ensureBrand(data.brand_id);
  if (await repo.findBySku(data.sku)) throw httpError(409, 'SKU already exists');
  try { return detailDTO(await repo.create(data)); }
  catch (err) { if (err.code === 'ER_DUP_ENTRY') throw httpError(409, 'Duplicate unique field'); throw err; }
}
export async function update(rawId, body) {
  const id = positiveId(rawId);
  const old = await repo.findOne(id);
  if (!old) throw httpError(404, 'Product not found');
  const patch = cleaned(body, false);
  await ensureBrand(patch.brand_id);
  try { return detailDTO(await repo.update(id, patch)); }
  catch (err) { if (err.code === 'ER_DUP_ENTRY') throw httpError(409, 'Duplicate unique field'); throw err; }
}
export async function remove(rawId) {
  const deleted = await repo.remove(positiveId(rawId));
  if (deleted === 0) throw httpError(404, 'Product not found');
}
