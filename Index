dler", "exception", "catch", "throw", "error", "เออเร่อ", "ขึ้นแดง"], ["400", "bad request", "ข้อมูลผิด", "invalid", "validate", "validation", "ไม่ถูกต้อง"], ["409", "duplicate", "sku ซ้ำ", "ซ้ำ", "conflict", "unique", "er_dup_entry"], ["500", "internal server error", "server พัง", "พัง", "เซิฟล่ม"], ["status", "http status", "response code", "code", "รหัสตอบกลับ", "สถานะ"], ["terminal", "powershell", "cmd", "command line", "หน้าจอดำ", "คอนโซล"], ["postman", "curl", "curl.exe", "ทดสอบ", "test", "ยิง api", "ทดสอบ api"], ["npm", "dependencies", "package", "node_modules", "module not found", "install"], ["เริ่ม", "เริ่มต้น", "ทำอะไรก่อน", "เริ่มยังไง", "ขั้นตอน", "first", "workflow"], ["student-info", "student id", "รหัสนักศึกษา", "secret key", "identity", "base path", "prefix"], ["brand", "brands", "brandname", "join", "สองตาราง", "ความสัมพันธ์", "foreign key"], ["node", "express", "app.js", "server", "เซิร์ฟเวอร์", "localhost", "3000"], ["ส่งงาน", "submit", "zip", "leb2", "upload", "บีบอัด"], ["int261", "spring", "java", "h2", "schema ต่าง", "spring boot"]]);
const searchEl=document.getElementById('search'), chapters=[...document.querySelectorAll('.chapter')], toc=[...document.querySelectorAll('#toc a')], statusEl=document.getElementById('searchstatus');
const norm=s=>(s||'').normalize('NFKC').toLocaleLowerCase().replace(/[_\-]+/g,' ').replace(/\s+/g,' ').trim();
const docs=chapters.map(c=>({el:c,id:c.id,title:norm(c.dataset.title),tags:norm(c.dataset.tags),body:norm(c.querySelector('.chapter-body').textContent)}));
const groups=synonymGroups.map(g=>g.map(norm));
function variants(term){let v=new Set([term]);for(const g of groups){if(g.some(x=>x===term || (term.length>3 && x.includes(term)) || (x.length>4 && term.includes(x))))for(const x of g)v.add(x);}return [...v];}
function editDistance(a,b){if(Math.abs(a.length-b.length)>2)return 9;let d=Array.from({length:b.length+1},(_,i)=>i);for(let i=1;i<=a.length;i++){let n=[i];for(let j=1;j<=b.length;j++)n.push(Math.min(n[j-1]+1,d[j]+1,d[j-1]+(a[i-1]===b[j-1]?0:1)));d=n;}return d[b.length];}
function scoreDoc(d,q){let terms=q.split(' ').filter(Boolean),score=0;for(let term of terms){const vs=variants(term);let m=0;for(const v of vs){if(v.length<2)continue;if(d.title.includes(v))m=Math.max(m,v===term?60:25);if(d.tags.includes(v))m=Math.max(m,v===term?42:19);if(d.body.includes(v))m=Math.max(m,v===term?10:4);}if(!m && /^[a-z0-9]{4,}$/.test(term)){const sample=d.tags.split(' ').filter(x=>/^[a-z0-9]{4,}$/.test(x)&&Math.abs(x.length-term.length)<=2).slice(0,140);if(sample.some(x=>editDistance(term,x)<=1))m=3;}if(!m)return 0;score+=m;}return score;}
function filterGuide(){const q=norm(searchEl.value);let results=[];for(const d of docs){const score=q?scoreDoc(d,q):1;d.el.classList.toggle('hidden',q?!score:false);if(score)results.push({d,score});}if(q){results.sort((a,b)=>b.score-a.score);statusEl.classList.add('visible');document.getElementById('searchtext').textContent=`พบ ${results.length} บท สำหรับ “${searchEl.value}” · รองรับคำพ้องและศัพท์ไทย/อังกฤษ`;document.getElementById('resultlinks').innerHTML=results.slice(0,16).map(r=>`<a href="#${r.d.id}">${r.d.el.dataset.title}</a>`).join('');document.getElementById('noresults').style.display=results.length?'none':'block';}else{statusEl.classList.remove('visible');}for(const a of toc){const hit=results.some(r=>r.d.id===a.getAttribute('href').slice(1));a.parentElement.classList.toggle('hidden',q?!hit:false);}}
let delayed;searchEl.addEventListener('input',()=>{clearTimeout(delayed);delayed=setTimeout(filterGuide,95);});document.getElementById('clear').onclick=()=>{searchEl.value='';filterGuide();searchEl.focus();};
window.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'||(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName))){e.preventDefault();searchEl.focus();searchEl.select();}if(e.key==='Escape'&&document.activeElement===searchEl){searchEl.value='';filterGuide();searchEl.blur();}});
document.getElementById('print').onclick=()=>window.print();document.getElementById('menuBtn').onclick=()=>document.getElementById('sidebar').classList.toggle('show');toc.forEach(a=>a.addEventListener('click',()=>document.getElementById('sidebar').classList.remove('show')));
document.querySelectorAll('[data-jump]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.jump).scrollIntoView({behavior:'smooth'})));
document.querySelectorAll('[data-query]').forEach(b=>b.addEventListener('click',()=>{searchEl.value=b.dataset.query;filterGuide();window.scrollTo({top:0,behavior:'smooth'});searchEl.focus();}));
function copyText(s){if(navigator.clipboard?.writeText){return navigator.clipboard.writeText(s).catch(()=>fallbackCopy(s));}return fallbackCopy(s);}
function fallbackCopy(s){const t=document.createElement('textarea');t.value=s;t.style.position='fixed';t.style.left='-9999px';document.body.append(t);t.select();try{document.execCommand('copy');}finally{t.remove();}return Promise.resolve();}
for(const pre of document.querySelectorAll('.chapter pre')){const wrap=document.createElement('div');wrap.className='codebox';pre.parentNode.insertBefore(wrap,pre);wrap.append(pre);const lang=pre.querySelector('code')?.className.replace('language-','')||'code';const lab=document.createElement('span');lab.className='lang';lab.textContent=lang.toUpperCase();wrap.append(lab);const btn=document.createElement('button');btn.className='copy';btn.textContent='Copy code';btn.addEventListener('click',()=>{copyText(pre.querySelector('code')?.textContent||pre.textContent).then(()=>{btn.textContent='✓ Copied';setTimeout(()=>btn.textContent='Copy code',1500);}).catch(()=>btn.textContent='Select + Ctrl+C');});wrap.append(btn);}
let size=1;try{size=Number(localStorage.getItem('int161-font'))||1;}catch{};function setSize(v){size=Math.max(.84,Math.min(1.42,v));document.documentElement.style.setProperty('--font-scale',size);try{localStorage.setItem('int161-font',String(size));}catch{}}setSize(size);document.getElementById('larger').onclick=()=>setSize(size+.08);document.getElementById('smaller').onclick=()=>setSize(size-.08);
</script></body></html>
