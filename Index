</tr>
<tr>
<td><strong>PUT / Update + Email</strong></td>
<td>Classicmodels <code>src/routes/employee-routes.js</code></td>
<td><code>req.params.id</code> + <code>req.body</code>, Regex</td>
</tr>
<tr>
<td><strong>DELETE / 204</strong></td>
<td>Classicmodels <code>src/routes/office-routes.js</code></td>
